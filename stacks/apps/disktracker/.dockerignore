# The build context is this whole directory; keep local state and installed dependencies out.
.local/
**/.venv/
**/node_modules/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
frontend/dist/
frontend/test-results/
frontend/playwright-report/
backend/tests/
# The frontend's tests read the backend's source kinds, which the frontend's build stage lacks.
frontend/tests/
collector/tests/
listing_text/tests/
tests/
