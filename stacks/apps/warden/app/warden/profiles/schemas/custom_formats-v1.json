{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Arr custom format interchange structure v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "includeCustomFormatWhenRenaming", "specifications"],
  "properties": {
    "name": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "trash_id": {"type": "string", "minLength": 1},
    "trash_scores": {"type": "object", "additionalProperties": {"type": "integer"}},
    "includeCustomFormatWhenRenaming": {"type": "boolean"},
    "specifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "implementation", "negate", "required", "fields"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "implementation": {"type": "string", "minLength": 1},
          "negate": {"type": "boolean"},
          "required": {"type": "boolean"},
          "fields": {
            "type": ["array", "object"],
            "additionalProperties": {"type": ["string", "number", "boolean", "null", "array"]},
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "value"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "value": {"type": ["string", "number", "boolean", "null", "array"]}
              }
            }
          }
        }
      }
    }
  }
}
